            <title>0.3.2-beta.6</title>
            <pubDate>Wed, 14 Oct 2026 00:28:36 -0400</pubDate>
            <sparkle:fullReleaseNotesLink>https://github.com/fif7y/pelmet/releases</sparkle:fullReleaseNotesLink>
            <sparkle:channel>beta</sparkle:channel>
            <sparkle:version>68</sparkle:version>
            <sparkle:shortVersionString>0.3.2-beta.6</sparkle:shortVersionString>
